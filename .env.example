# =============================================================================
# UniVA Configuration (.env)
# =============================================================================
# This file contains sensitive information, API keys, and environment-specific paths.
# Copy this file to .env and fill in your values.
#
# NOTE: Variables defined here will override defaults in univa/config/config.py
# and univa/config/mcp_tools_config/config.yaml.

# =========================
# Core Agent Models (Planning & Acting)
# =========================
# Configure the LLMs used by the main agents.

# --- DeepSeek ---
# PLAN_MODEL_PROVIDER=deepseek
# PLAN_MODEL_ID=deepseek-reasoner
# PLAN_MODEL_API_KEY=sk-...
# PLAN_MODEL_BASE_URL=https://api.deepseek.com

# --- Plan Agent ---
PLAN_MODEL_PROVIDER=deepseek
PLAN_MODEL_ID=deepseek-reasoner
PLAN_MODEL_API_KEY=
PLAN_MODEL_BASE_URL=https://api.deepseek.com
PLAN_MODEL_EXTRA_PARAMS={}

# --- Act Agent ---
ACT_MODEL_PROVIDER=deepseek
ACT_MODEL_ID=deepseek-reasoner
ACT_MODEL_API_KEY=
ACT_MODEL_BASE_URL=https://api.deepseek.com
ACT_MODEL_EXTRA_PARAMS={}

# =========================
# System Configuration
# =========================
# Basic system settings.

# Repo-local runtime directories and backend bind address.
UNIVA_CACHE_DIR=results/cache/univa
UNIVA_CONFIG_DIR=temp/config/univa
UNIVA_SERVER_HOST=0.0.0.0
UNIVA_SERVER_PORT=8000

# Enable access code authentication (optional, default: False)
AUTH_ENABLED=False
# Admin access code for system management
ADMIN_ACCESS_CODE=
# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=60
# Maximum concurrent sessions per user
MAX_SESSIONS_PER_USER=10

# Proxy settings (optional)
# PROXY_HOST=127.0.0.1
# PROXY_PORT=7890

# =========================
# MCP Tools Configuration
# =========================
# Configuration for the Model Context Protocol tools.

# --- Shared API Keys ---
# OpenAI API Key for tools using LLMs (e.g., query_llm)
LLM_OPENAI_API_KEY=

# Image generation provider: wavespeed or volcengine_ark
IMAGE_GEN_PROVIDER=volcengine_ark

# Wavespeed API Key for generation tools (image, video, audio)
WAVESPEED_API_KEY=

# Volcengine Ark API Key for Seedance2 video generation
# Get your key at: https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
ARK_API_KEY=

# Non-sensitive MCP defaults live in univa/config/mcp_tools_config/config.yaml.
# Add model/base URL/audio override variables here only when changing those defaults.

# --- Local Model Paths ---
# Absolute paths to local model checkpoints. 
# Leave empty if using API-based alternatives or if not applicable.

# Video Editing (Wan2.1, VACE)
VIDEO_EDIT_MODEL_PATH=

# Video Understanding (Qwen2.5-VL)
VIDEO_UNDERSTAND_MODEL_PATH=

# Video Retrieval (BGE-VL)
VIDEO_RETRIEVER_MODEL_PATH=

# Video Tracking (Sa2VA)
VIDEO_TRACK_SA2VA_PATH=

# Video Tracking (SAM 2)
VIDEO_TRACK_SAM_PATH=


# =========================
# Reference: Provider Examples
# =========================

# --- DeepSeek ---
# PLAN_MODEL_PROVIDER=deepseek
# PLAN_MODEL_ID=deepseek-reasoner
# PLAN_MODEL_API_KEY=sk-...
# PLAN_MODEL_BASE_URL=https://api.deepseek.com

# --- Qwen via DashScope ---
# PLAN_MODEL_PROVIDER=dashscope
# PLAN_MODEL_ID=qwen-plus-latest
# PLAN_MODEL_API_KEY=sk-...
# PLAN_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Local OpenAI-Compatible (vLLM/Ollama) ---
# PLAN_MODEL_PROVIDER=openai
# PLAN_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# PLAN_MODEL_API_KEY=dummy
# PLAN_MODEL_BASE_URL=http://localhost:8000/v1

# Runtime MCP provider overrides
VIDEO_GEN_PROVIDER=volcengine_ark
VIDEO_EDITING_PROVIDER=volcengine_ark
AUDIO_GEN_PROVIDER=wavespeed

# Optional image upload service
IMAGE_UPLOAD_URL=https://web.aizex.top/api/upload-oss
IMAGE_UPLOAD_API_KEY=
IMAGE_UPLOAD_MODEL=mj-chat
IMAGE_UPLOAD_ORIGIN=https://web.aizex.top
IMAGE_UPLOAD_REFERER=https://web.aizex.top/
