{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://univa.online/schemas/artifacts/scene_plan.schema.json",
  "title": "Scene Plan",
  "description": "The scene plan produced by the scene_plan stage. Contains detailed shot-level production plans.",
  "type": "object",
  "required": ["shots"],
  "properties": {
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "keyframe_prompt", "shot_perspective_design", "required_assets"],
        "properties": {
          "shot_id": { "type": "string" },
          "keyframe_prompt": {
            "type": "string",
            "description": "The complete prompt for keyframe image generation"
          },
          "shot_perspective_design": {
            "type": "object",
            "required": ["distance", "angle", "lens"],
            "properties": {
              "distance": { "type": "string" },
              "angle": { "type": "string" },
              "lens": { "type": "string" },
              "movement": { "type": "string" }
            }
          },
          "onstage_characters": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_assets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "tool"],
              "properties": {
                "type": { "type": "string", "enum": ["character_image", "keyframe_image", "video_segment", "audio"] },
                "tool": { "type": "string" },
                "prompt": { "type": "string" },
                "dependencies": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "duration_seconds": { "type": "number", "default": 5 }
        }
      }
    },
    "style_anchors": {
      "type": "object",
      "description": "Style consistency tokens to carry through all asset generation",
      "properties": {
        "color_palette": { "type": "string" },
        "lighting": { "type": "string" },
        "atmosphere": { "type": "string" },
        "style_keywords": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
