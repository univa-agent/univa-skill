{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://univa.online/schemas/artifacts/proposal.schema.json",
  "title": "Creative Proposal",
  "description": "A creative proposal generated by the proposal stage. Contains differentiated creative directions for video generation.",
  "type": "object",
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "description": "2-3 differentiated creative proposals",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "theme", "visual_style", "estimated_shot_count"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique proposal identifier (e.g., 'proposal_1')"
          },
          "theme": {
            "type": "string",
            "description": "Core theme/concept of the proposal",
            "minLength": 10
          },
          "visual_style": {
            "type": "string",
            "description": "Visual style description with specific keywords",
            "minLength": 10
          },
          "mood_keywords": {
            "type": "array",
            "description": "Mood/atmosphere keywords",
            "items": {"type": "string"}
          },
          "visual_elements": {
            "type": "array",
            "description": "Key visual elements to include",
            "items": {"type": "string"}
          },
          "estimated_shot_count": {
            "type": "integer",
            "description": "Estimated number of shots",
            "minimum": 1,
            "maximum": 30
          },
          "estimated_duration_seconds": {
            "type": "integer",
            "description": "Estimated total duration in seconds",
            "minimum": 5,
            "maximum": 300
          },
          "color_palette": {
            "type": "string",
            "description": "Color palette description"
          },
          "differentiation": {
            "type": "string",
            "description": "How this proposal differs from others"
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "description": "ISO timestamp of generation"
    }
  }
}
